# =============================================================================
# Application Environment — Managed by Ansible
# =============================================================================
# WARNING: Do not edit manually. Changes will be overwritten.
# This file contains secrets — permissions should be 0600
# =============================================================================

# ---------- Application ----------
APP_NAME={{ app_name }}
APP_ENV={{ app_env }}
APP_PORT={{ app_port }}
APP_HOME={{ app_home }}/current
APP_LOG_DIR={{ app_log_dir }}

# ---------- Database ----------
DB_HOST={{ groups['db'][0] | default('localhost') }}
DB_PORT={{ postgresql_port | default('5432') }}
DB_NAME={{ postgresql_db_name | default('myapp') }}
DB_USER={{ postgresql_db_user | default('myapp') }}
DB_PASSWORD={{ vault_postgresql_password | default('changeme') }}
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30

# ---------- Runtime ----------
JAVA_OPTS={{ app_java_opts | default('') }}

# ---------- Secrets ----------
APP_SECRET_KEY={{ vault_app_secret_key | default('changeme') }}
